<?xml version="1.0" encoding="utf-8"?>
<!--
  Bug #4 fix:
  - base-config now disables cleartext globally so stream traffic is always HTTPS.
  - The previous domain-config used IP network prefixes (e.g. 192.168.0.0) which
    Android silently ignores — <domain> accepts hostnames, not CIDR ranges.
  - Replaced with the two specific IPs used for LAN P2P transfer:
      192.168.49.1  — Wi-Fi Direct group owner address (Android WD standard)
      192.168.43.1  — common Android hotspot gateway address
    These are the only hosts the app ever contacts over cleartext (TCP socket
    transfers between devices on the local segment).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext only on the specific LAN IPs used for P2P transfer -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Wi-Fi Direct group owner (sender side) -->
        <domain includeSubdomains="false">192.168.49.1</domain>
        <!-- Android hotspot gateway (fallback transfer path) -->
        <domain includeSubdomains="false">192.168.43.1</domain>
    </domain-config>
</network-security-config>
